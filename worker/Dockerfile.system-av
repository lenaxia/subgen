# Use system PyAV to avoid long compilation
FROM python:3.11

# Install FFmpeg and python3-av from system packages
RUN apt-get update && apt-get install -y \
    ffmpeg \
    python3-av \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create requirements without 'av' package
COPY worker/requirements.txt /tmp/requirements.txt
RUN grep -v "^av==" /tmp/requirements.txt > requirements-no-av.txt || cp /tmp/requirements.txt requirements-no-av.txt

# Install Python dependencies (excluding av since we have system package)
RUN pip install --no-cache-dir -r requirements-no-av.txt

# Copy application code
COPY worker/src/ ./src/
COPY worker/pb/ ./pb/
COPY language_code.py ./

# Set Python path - include pb directory for protobuf imports
ENV PYTHONPATH=/app/src:/app:/app/pb

# Health check (HTTP on port 8080)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Expose ports
EXPOSE 50051  # gRPC for work
EXPOSE 8080   # HTTP for health checks

# Run as non-root user
RUN useradd -m -u 1000 worker
USER worker

# Start the worker
CMD ["python", "-m", "src.main"]

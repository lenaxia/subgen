# Use system PyAV to avoid long compilation
FROM python:3.11

# Install FFmpeg and python3-av from system packages
RUN apt-get update && apt-get install -y \
    ffmpeg \
    python3-av \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create requirements without 'av' package
COPY worker/requirements.txt /tmp/requirements.txt
RUN grep -v "^av==" /tmp/requirements.txt > requirements-no-av.txt || cp /tmp/requirements.txt requirements-no-av.txt

# Install Python dependencies (excluding av since we have system package)
RUN pip install --no-cache-dir -r requirements-no-av.txt

# Copy application code
COPY worker/src/ ./src/
COPY worker/pb/ ./pb/
COPY language_code.py ./

# Set Python path
ENV PYTHONPATH=/app/src:/app

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import grpc; from pb import transcription_pb2, transcription_pb2_grpc; \
    channel = grpc.insecure_channel('localhost:50051'); \
    stub = transcription_pb2_grpc.TranscriptionServiceStub(channel); \
    response = stub.HealthCheck(transcription_pb2.HealthCheckRequest()); \
    exit(0 if response.status == 1 else 1)"

# Expose gRPC port
EXPOSE 50051

# Run as non-root user
RUN useradd -m -u 1000 worker
USER worker

# Start the worker
CMD ["python", "-m", "src.main"]

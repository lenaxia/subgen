# Simplified Dockerfile for Python worker
# Uses standard Python image for better package compatibility

FROM python:3.11

# Install FFmpeg and PyAV build dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    pkg-config \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
# Using standard python:3.11 gives us better wheel support
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ ./src/
COPY pb/ ./pb/

# Set Python path
ENV PYTHONPATH=/app/src:/app

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import grpc; from pb import transcription_pb2, transcription_pb2_grpc; \
    channel = grpc.insecure_channel('localhost:50051'); \
    stub = transcription_pb2_grpc.TranscriptionServiceStub(channel); \
    response = stub.HealthCheck(transcription_pb2.HealthCheckRequest()); \
    exit(0 if response.status == 1 else 1)"

# Expose gRPC port
EXPOSE 50051

# Run as non-root user
RUN useradd -m -u 1000 worker
USER worker

# Start the worker
CMD ["python", "-m", "src.main"]

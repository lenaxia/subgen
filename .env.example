# Media Server Configuration
MEDIA_SERVER_TYPE=plex
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token-here
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-key-here

# Volume Mappings
TV=/path/to/tv
MOVIES=/path/to/movies
MUSIC=/path/to/music
MODEL_PATH=./data/models

# Whisper Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
COMPUTE_TYPE=auto

# Processing Configuration
CONCURRENT_TRANSCRIPTIONS=2
PROC_ADDED_MEDIA=true
PROC_MEDIA_ON_PLAY=false
SKIP_IF_INTERNAL_SUB_LANG=eng

# Subtitle Configuration
NAME_SUB_LANG=aa
WORD_LEVEL_HIGHLIGHT=false
LRC_FOR_AUDIO_FILES=true
CUSTOM_REGROUP=cm_sl=84_sl=42++++++1

# Path Mapping (optional)
USE_PATH_MAPPING=false
PATH_MAPPING_FROM=/tv
PATH_MAPPING_TO=/tv

# Logging
LOG_LEVEL=info
DEBUG=false

# Build Variables (optional)
VERSION=dev
BUILD_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
